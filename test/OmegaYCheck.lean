/-- (c): the Lean expansion gives the official values. -/
def valuesAgree (f : Fixture) : Bool :=
  match expand f.1 f.2.1 with
  | .ok t => t == f.2.2
  | .error _ => false

/-- (a): the built mountain is the canonical mountain of the output. -/
def canonicalAgree (f : Fixture) : Bool :=
  match expandDiagram f.1 f.2.1, Canonical.build f.2.2 with
  | .ok built, .ok canonical => Canonical.fullSummary built == Canonical.fullSummary canonical
  | _, _ => false

/-- Lexicographic order on finite sequences (a proper prefix is smaller). -/
def lexLt : List Nat → List Nat → Bool
  | [], [] => false
  | [], _ :: _ => true
  | _ :: _, [] => false
  | a :: as, b :: bs => a < b || (a == b && lexLt as bs)

/-- (b): the expansion is smaller than the input. -/
def decreases (f : Fixture) : Bool := lexLt f.2.2 f.1

/-- Whether Phyrion's weak-magma rule `Expansion.expand` gives the same values.
It is not a check; it shows that the fixtures separate the two rules. -/
def weakAgrees (f : Fixture) : Bool :=
  match Expansion.expand f.1 f.2.1 with
  | .ok t => t == f.2.2
  | .error _ => false

