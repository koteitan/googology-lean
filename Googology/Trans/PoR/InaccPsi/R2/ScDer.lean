import Googology.Trans.PoR.InaccPsi.R2.ScLim

/-!
# Derivations of exponents: the level construction stated once, and its soundness

`Θ = gxTh ρ_λ (ldAtR λ)`, `W^E = Ω₂^E`, `Ω^x = Ω₁^x`, `T_E(β) = ψ_{Ω₂}(β + W^E)`, `SQ_j = Sc.scSq` of the lifted
shape `ζ ↦ W^{g ζ}`.

`ScDer S λ Ow E Ê` (**a derivation of the exponent `E` with the image `Ê` and the own predicate `Ow`**), generated by
* `code`: a code `1 ≤ E < Ω₂` with `Ê = Θ E`, own via `Rw.rwEX`;
* `succ`: `E` gives `E + 1` (image `Ê + 1`, the same own predicate);
* `om`: a shape `(g, ĝ, g*, ĝ*)` valid under a monotone `Ow` whose members `g ζ` (`1 ≤ ζ < Ω₂` codes) are derived
  with the own predicates `Ow ∧ ζ < SQ_j` give the limit exponent `g*` (image `ĝ*`): **the next level**;
* `lim`: the same shape, `η` a limit code: the members `g(ζ+1)`, `ζ < η`, give `g η` (image `ĝ(Θ η)`);
* `weaken`: a stronger monotone own predicate with the data.
Shapes nest (`Sc.scShp_lift` of a shape is a shape), so one derivation can climb any number of levels.

* `scOwP_succ`, `scOwP_om`, `scDer_sound` (**SOUNDNESS: every derivation gives the level statement
  `ScLev Ow E Ê` (the top law at `X₀ + W^E` over every offset and base) and the data of `Ow`**);
* `scDer_W` (`W = Ω₂`, image `Ω₁`, own predicate `⊤`: the first exponent above the codes), `scLev_W'`.

No new axiom.  New definition: `ScDer`.
-/

namespace Googology.Trans.PoR.InaccPsi.R2.Sc

open Ordinal Order Set Googology.Notation.InaccPsi Googology.Notation.InaccPsi.InaccSeq
  Googology.Trans.PoR.InaccPsi.R2 Googology.Trans.PoR.InaccPsi.R2.Gg Googology.Trans.PoR.InaccPsi.R2.Mx
  Googology.Trans.PoR.InaccPsi.R2.Cd Googology.Trans.PoR.InaccPsi.R2.Ld Googology.Trans.PoR.InaccPsi.R2.Nm
  Googology.Trans.PoR.InaccPsi.R2.Le Googology.Trans.PoR.InaccPsi.R2.Rn Googology.Trans.PoR.InaccPsi.R2.Ro
  Googology.Trans.PoR.InaccPsi.R2.Rq Googology.Trans.PoR.InaccPsi.R2.Rv Googology.Trans.PoR.InaccPsi.R2.Rw

variable {S : InaccSeq.{0}}

/-- **A derivation of the exponent `E` (image `Ê`, own predicate `Ow`).** -/
inductive ScDer (S : InaccSeq.{0}) (l : Ordinal.{0}) :
    (Ordinal.{0} → Ordinal.{0} → Prop) → Ordinal.{0} → Ordinal.{0} → Prop
  | code {E : Ordinal.{0}} : GxCl (upsilon l) (ldAtR S l) E → 1 ≤ E → E < Om (1 + 1) →
      ScDer S l (fun b X0 => ∃ j, E < rwEX S X0 b j) E (gxTh (upsilon l) (ldAtR S l) E)
  | succ {Ow : Ordinal.{0} → Ordinal.{0} → Prop} {E Eh : Ordinal.{0}} :
      ScDer S l Ow E Eh → ScDer S l Ow (E + 1) (Eh + 1)
  | om {Ow : Ordinal.{0} → Ordinal.{0} → Prop} {g gh : Ordinal.{0} → Ordinal.{0}} {gs ghs : Ordinal.{0}} :
      (∀ b X0, Ow b X0 → ScShp S l g gh gs ghs (leTe S (X0 + leWe (g 1)) b)
        (gxTh (upsilon l) (ldAtR S l) (leTe S (X0 + leWe (g 1)) b))) →
      (∀ b β X0 X0', Ow b X0 → b ≤ β → X0 ≤ X0' → Ow β X0') →
      (∀ ζ, GxCl (upsilon l) (ldAtR S l) ζ → 1 ≤ ζ → ζ < Om (1 + 1) →
        ScDer S l (fun b X0 => Ow b X0 ∧ ∃ j, ζ < scSq S (fun z => leWe (g z)) X0 b j) (g ζ)
          (gh (gxTh (upsilon l) (ldAtR S l) ζ))) →
      ScDer S l Ow gs ghs
  | lim {Ow : Ordinal.{0} → Ordinal.{0} → Prop} {g gh : Ordinal.{0} → Ordinal.{0}} {gs ghs η : Ordinal.{0}} :
      (∀ b X0, Ow b X0 → ScShp S l g gh gs ghs (leTe S (X0 + leWe (g 1)) b)
        (gxTh (upsilon l) (ldAtR S l) (leTe S (X0 + leWe (g 1)) b))) →
      (∀ b β X0 X0', Ow b X0 → b ≤ β → X0 ≤ X0' → Ow β X0') →
      GxCl (upsilon l) (ldAtR S l) η → η < Om (1 + 1) → IsSuccLimit η →
      (∀ ζ, GxCl (upsilon l) (ldAtR S l) ζ → ζ < η →
        ScDer S l (fun b X0 => Ow b X0 ∧ ∃ j, ζ + 1 < scSq S (fun z => leWe (g z)) X0 b j) (g (ζ + 1))
          (gh (gxTh (upsilon l) (ldAtR S l) (ζ + 1)))) →
      ScDer S l (fun b X0 => Ow b X0 ∧ ∃ j, η < scSq S (fun z => leWe (g z)) X0 b j) (g η)
        (gh (gxTh (upsilon l) (ldAtR S l) η))
  | weaken {Ow Ow' : Ordinal.{0} → Ordinal.{0} → Prop} {E Eh : Ordinal.{0}} :
      ScDer S l Ow E Eh → (∀ b X0, Ow' b X0 → Ow b X0) →
      (∀ b β X0 X0', Ow' b X0 → b ≤ β → X0 ≤ X0' → Ow' β X0') → ScDer S l Ow' E Eh

/-- The own data pass from `E` to `E + 1`. -/
theorem scOwP_succ {l : Ordinal.{0}} {Ow : Ordinal.{0} → Ordinal.{0} → Prop} {E Eh : Ordinal.{0}}
    (h : ScOwP S l Ow E Eh) : ScOwP S l Ow (E + 1) (Eh + 1) := by
  refine ⟨fun b X0 hOw => ?_, h.mono⟩
  have hd := h.dat b X0 hOw
  have hle := scTop_mono (S := S) (le_refl b) (le_refl X0) (le_self_add : E ≤ E + 1)
  exact ⟨le_add_self, CSet.succ_mem hd.hull, CSet.succ_mem (CSet_mono le_rfl hle hd.mem),
    CSet.succ_mem (CSet_mono le_rfl (gxTh_mono hle) hd.memh),
    fun Q hQ hY => LeCl.add (hd.cl Q hQ (hle.trans hY)) (LeCl.small (gg_one_lt_of_SC hQ)),
    fun Q hQ hY => LeCl.add (hd.clh Q hQ ((gxTh_mono hle).trans hY)) (LeCl.small (gg_one_lt_of_SC hQ))⟩

/-- The own data of the limit exponent of a shape. -/
theorem scOwP_om {l : Ordinal.{0}} {Ow : Ordinal.{0} → Ordinal.{0} → Prop} {g gh : Ordinal.{0} → Ordinal.{0}}
    {gs ghs : Ordinal.{0}}
    (hshp : ∀ b X0, Ow b X0 → ScShp S l g gh gs ghs (leTe S (X0 + leWe (g 1)) b)
      (gxTh (upsilon l) (ldAtR S l) (leTe S (X0 + leWe (g 1)) b)))
    (hmono : ∀ b β X0 X0', Ow b X0 → b ≤ β → X0 ≤ X0' → Ow β X0') : ScOwP S l Ow gs ghs := by
  refine ⟨fun b X0 hOw => ?_, hmono⟩
  have hsh := hshp b X0 hOw
  have hle : leTe S (X0 + leWe (g 1)) b ≤ S.psi (b + leWe (X0 + leWe gs)) (Om (1 + 1)) :=
    scTop_mono le_rfl le_rfl (hsh.lt 1 (gg_one_lt_of_SC ldOm2_SC)).le
  exact ⟨(one_lt_omega0.trans_le hsh.inf).le, hsh.hullS, hsh.memS _ hle, hsh.memhS _ (gxTh_mono hle),
    fun Q hQ hY => hsh.clS Q hQ (hle.trans hY), fun Q hQ hY => hsh.clhS Q hQ ((gxTh_mono hle).trans hY)⟩

section Sound

variable {l ηx : Ordinal.{0}} (hl : IsRestartIdx l) (hX : upsilon l < Pv S ηx)

include hl hX

/-- **SOUNDNESS: every derivation gives the level statement and the data of its own predicate.** -/
theorem scDer_sound {Ow : Ordinal.{0} → Ordinal.{0} → Prop} {E Eh : Ordinal.{0}} (h : ScDer S l Ow E Eh) :
    ScLev S l Ow E Eh ∧ ScOwP S l Ow E Eh := by
  induction h with
  | code hE h1 hEW => exact ⟨scLev_code_iff.2 (rwLevC_all hl hX _ hE h1 hEW), scOwP_code hl hX h1 hE hEW⟩
  | succ _ IH => exact ⟨scLev_succ hl hX IH.2 IH.1 (fun _ _ h => h), scOwP_succ IH.2⟩
  | om hshp hmono _ IH =>
    exact ⟨scLev_om hl hX hshp (fun b β X0 hO hb => hmono b β X0 X0 hO hb le_rfl)
      (fun ζ hζ h1 hζW => (IH ζ hζ h1 hζW).1), scOwP_om hshp hmono⟩
  | lim hshp hmono hη hηW hlim _ IH =>
    exact ⟨scLev_lim hl hX hshp hmono hη hηW hlim (fun ζ hζ hζη => (IH ζ hζ hζη).1),
      scOwP_mem hshp hmono hη (rvLim_one_lt hlim).le⟩
  | weaken _ himp hmono IH =>
    exact ⟨fun b X0 Xh0 hoff hd hG3 hG hO => IH.1 b X0 Xh0 hoff hd hG3 hG (himp b X0 hO),
      ⟨fun b X0 hO => IH.2.dat b X0 (himp b X0 hO), hmono⟩⟩

/-- **`W = Ω₂` is derived** (image `Ω₁`, own predicate `⊤`): the members are the codes. -/
theorem scDer_W : ScDer S l (fun _ _ => True) (Om (1 + 1)) (Om 1) := by
  refine ScDer.om (g := fun z => z) (gh := fun v => v) (fun b X0 _ => scShp_code hl hX _ _)
    (fun _ _ _ _ _ _ _ => trivial) fun ζ hζ h1 hζW => ?_
  refine ScDer.weaken (ScDer.code hζ h1 hζW) (fun b X0 ⟨_, j, hj⟩ => ⟨j, by rwa [scSq_code] at hj⟩) ?_
  intro b β X0 X0' ⟨_, j, hj⟩ hb hXX
  have hmo : Monotone (fun z : Ordinal.{0} => leWe z) := fun a c h => leWe_mono h
  exact ⟨trivial, j, hj.trans_le ((scSq_mono_base hmo hb j).trans (scSq_mono_off hmo hXX j))⟩

/-- The top at `W^{Ω₂}` over every offset, from the derivation (`Sc.scLev_W` again, through soundness). -/
theorem scLev_W' : ScLev S l (fun _ _ => True) (Om (1 + 1)) (Om 1) := (scDer_sound hl hX (scDer_W hl hX)).1

end Sound

end Googology.Trans.PoR.InaccPsi.R2.Sc
