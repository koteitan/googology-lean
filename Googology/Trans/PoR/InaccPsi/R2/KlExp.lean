import Googology.Trans.PoR.InaccPsi.R2.KkOwn

/-!
# Kl: THE `W`-TERMS OVER THE CODES (exponents whose `W`-normal form bottoms out in codes), their exponent data

`W^x = leWe x`, `Ω^x = leOe x`, `T = Vb.vbT S λ`, `Θ`, `Zx.ZxEx` (exponent data with a code threshold).  The class
`KlWT λ` is generated by the codes `g < θ` and by `W^{g₁}·u + r` (`g₁`, `r` in the class, `u` a code with
`0 < u < θ`, `r < W^{g₁}`); its members have no `W`-fixed points (`klLt`: `x < W^x`).

* `klD` (`KlWT g ⇒ g ∈ D`), `klEx` (**EVERY `W`-TERM IS EXPONENT DATA**: `∃ q, ZxEx λ g (T g) q`, the threshold the
  maximum of the code components), `klLt`.

No new axiom.  New definition: `KlWT`.
-/

set_option autoImplicit false

namespace Googology.Trans.PoR.InaccPsi.R2.Kl

open Ordinal Order Set Googology.Notation.InaccPsi Googology.Notation.InaccPsi.InaccSeq
  Googology.Trans.PoR.InaccPsi.R2 Googology.Trans.PoR.InaccPsi.R2.Gg Googology.Trans.PoR.InaccPsi.R2.Mx
  Googology.Trans.PoR.InaccPsi.R2.Ld Googology.Trans.PoR.InaccPsi.R2.Cd Googology.Trans.PoR.InaccPsi.R2.Vk
  Googology.Trans.PoR.InaccPsi.R2.Vb Googology.Trans.PoR.InaccPsi.R2.Le Googology.Trans.PoR.InaccPsi.R2.Nm
  Googology.Trans.PoR.InaccPsi.R2.Bt Googology.Trans.PoR.InaccPsi.R2.Zx Googology.Trans.PoR.InaccPsi.R2.Zy
  Googology.Trans.PoR.InaccPsi.R2.Zz

variable {S : InaccSeq.{0}}

/-- **The `W`-terms over the codes.** -/
inductive KlWT (S : InaccSeq.{0}) (l : Ordinal.{0}) : Ordinal.{0} → Prop
  | code {g : Ordinal.{0}} : GxCl (upsilon l) (ldAtR S l) g → g < ConjT.th S → KlWT S l g
  | term {g₁ u r : Ordinal.{0}} : KlWT S l g₁ → GxCl (upsilon l) (ldAtR S l) u → 0 < u → u < ConjT.th S →
      KlWT S l r → r < leWe g₁ → KlWT S l (leWe g₁ * u + r)

/-- **No `W`-fixed point**: `x < W^x` for every `W`-term. -/
theorem klLt {l : Ordinal.{0}} {x : Ordinal.{0}} (hx : KlWT S l x) : x < leWe x := by
  have hκ2 : S.InR (Om (1 + 1 : Ordinal.{0})) := InR_Om_succ 1
  induction hx with
  | @code g _ hθ =>
    rcases eq_or_ne g 0 with rfl | h0
    · rw [leWe_zero]; exact zero_lt_one
    · have h1 : (1 : Ordinal.{0}) ≤ g := Order.one_le_iff_pos.2 (pos_iff_ne_zero.2 h0)
      calc g < Om (1 + 1) := hθ.trans (psi_lt hκ2 _)
        _ = leWe 1 := leWe_one.symm
        _ ≤ leWe g := leWe_mono h1
  | @term g₁ u r _ _ hu0 huθ _ hr ih₁ _ =>
    have hu2 : u < Om (1 + 1) := huθ.trans (psi_lt hκ2 _)
    have hlt : leWe g₁ * u + r < leWe (g₁ + 1) := by
      calc leWe g₁ * u + r < leWe g₁ * u + leWe g₁ := (add_lt_add_iff_left _).2 hr
        _ = leWe g₁ * (u + 1) := (mul_add_one _ _).symm
        _ ≤ leWe g₁ * Om (1 + 1) := leMulWe_mono (Order.add_one_le_of_lt hu2)
        _ = leWe (g₁ + 1) := (leWe_succ g₁).symm
    have hg₁ : g₁ + 1 ≤ leWe g₁ * u + r :=
      Order.add_one_le_of_lt (ih₁.trans_le ((Ordinal.le_mul_left _ hu0).trans le_self_add))
    exact hlt.trans_le (leWe_mono hg₁)

section Main

variable {l ηx : Ordinal.{0}} (hl : IsRestartIdx l) (hX : upsilon l < Pv S ηx)

include hl hX

/-- **Every `W`-term is exponent data** (with a code threshold). -/
theorem klEx {g : Ordinal.{0}} (hg : KlWT S l g) : ∃ q, ZxEx S l g (vbT S l g) q := by
  have hκ2 : S.InR (Om (1 + 1 : Ordinal.{0})) := InR_Om_succ 1
  induction hg with
  | @code g hc hθ =>
    have h := Zz.zxEx_code hl hX hc hθ
    have h2 : g < Om (1 + 1) := hθ.trans (psi_lt hκ2 _)
    rw [← vbT_code hl hX h2 ((ldHull_iff hl hX h2).2 hc)] at h
    exact ⟨g, h⟩
  | @term g₁ u r _ huc hu0 huθ _ hr ih₁ ihr =>
    obtain ⟨q₁, h1⟩ := ih₁
    obtain ⟨qr, hrx⟩ := ihr
    have hu2 : u < Om (1 + 1) := huθ.trans (psi_lt hκ2 _)
    have huH : u ∈ cdHull S l := (ldHull_iff hl hX hu2).2 huc
    have hg1W : g₁ + 1 < Om ω := vkOmW.1.isSuccLimit.add_one_lt h1.D.2.2
    have hlt : leWe g₁ * u + r < leWe (g₁ + 1) := by
      calc leWe g₁ * u + r < leWe g₁ * u + leWe g₁ := (add_lt_add_iff_left _).2 hr
        _ = leWe g₁ * (u + 1) := (mul_add_one _ _).symm
        _ ≤ leWe g₁ * Om (1 + 1) := leMulWe_mono (Order.add_one_le_of_lt hu2)
        _ = leWe (g₁ + 1) := (leWe_succ g₁).symm
    have hD : VbD S l (leWe g₁ * u + r) :=
      ⟨CSet.add_mem (leMulWe_mem h1.D.1 huH) hrx.D.1,
        CSet.add_mem (leMulWe_mem h1.D.2.1 (CSet.of_lt huθ)) hrx.D.2.1,
        hlt.trans (leWe_lt_SC vkOmW.1 vkOmW.2 hg1W).1⟩
    have hT : vbT S l (leWe g₁ * u + r) = leOe (vbT S l g₁) * gxTh (upsilon l) (ldAtR S l) u + vbT S l r :=
      Vh.vhT_cnfW hl hX h1.D hrx.D huH hu2
    have hmax : ∀ c, max q₁ (max u qr) < c → q₁ < c ∧ u < c ∧ qr < c := fun c h =>
      ⟨(le_max_left _ _).trans_lt h, ((le_max_left _ _).trans (le_max_right _ _)).trans_lt h,
        ((le_max_right _ _).trans (le_max_right _ _)).trans_lt h⟩
    have hmaxΘ : ∀ c, gxTh (upsilon l) (ldAtR S l) (max q₁ (max u qr)) < c →
        gxTh (upsilon l) (ldAtR S l) q₁ < c ∧ gxTh (upsilon l) (ldAtR S l) u < c ∧
          gxTh (upsilon l) (ldAtR S l) qr < c := fun c h =>
      ⟨(gxTh_mono (le_max_left _ _)).trans_lt h, (gxTh_mono ((le_max_left _ _).trans (le_max_right _ _))).trans_lt h,
        (gxTh_mono ((le_max_right _ _).trans (le_max_right _ _))).trans_lt h⟩
    refine ⟨max q₁ (max u qr), hD, rfl, fun a c h hq => ?_, fun a c h hq => ?_,
      zy_max_code h1.qc (zy_max_code huc hrx.qc), max_lt h1.qθ (max_lt huθ hrx.qθ)⟩
    · obtain ⟨h₁, h₂, h₃⟩ := hmax c hq
      exact CSet.add_mem (leMulWe_mem (h1.mem a c h h₁) (CSet.of_lt h₂)) (hrx.mem a c h h₃)
    · obtain ⟨h₁, h₂, h₃⟩ := hmaxΘ c hq
      rw [hT]
      exact CSet.add_mem (leMulOe_mem (h1.Hm a c h h₁) (CSet.of_lt h₂)) (hrx.Hm a c h h₃)

theorem klD {g : Ordinal.{0}} (hg : KlWT S l g) : VbD S l g := (klEx hl hX hg).choose_spec.D

end Main

end Googology.Trans.PoR.InaccPsi.R2.Kl

#print axioms Googology.Trans.PoR.InaccPsi.R2.Kl.klEx
