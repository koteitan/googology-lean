import Googology.Trans.PoR.InaccPsi.R2.TsX

/-!
# Normal forms in base `Ω₂` with components in a set `P`

`w_j = Ω₂^j = Le.leWe j`, `W = Ω₂^{Ω₂}`.  `TzG P x` says that `x` is `Σ w_{j_i}·d_i` (`j_0 > j_1 > …`, `0 < d_i < Ω₂`)
with every level `j_i` and every digit `d_i` in `P`.  It is generated by `0` and `x = w_j·d + r` with `r < w_j`.

* `tz_term_bounds`, `tz_lev_unique`, `tz_div_eq`, `tz_mod_eq`: the top term of `w_j·d + r` is read off uniquely;
* `tzG_inv` (**inversion**), `TzG.mono`, `tzG_small`, `tzG_one`, `tzG_Om2`;
* `tzG_add` (**closed under `+`** when `P` is), `tzG_snoc_inv` (**the last term**: `TzG P (B + w_λ·D)` with
  `w_{λ+1} ∣ B`, `0 < D < Ω₂` gives `P λ`, `P D`, `TzG P B`), `tzG_phi` (**closed under `φ` below `W`** when `P` is).

No new axiom.  New definition: `TzG`.
-/

set_option autoImplicit false

namespace Googology.Trans.PoR.InaccPsi.R2.Tz

open Ordinal Order Set Googology.Notation.InaccPsi Googology.Notation.InaccPsi.InaccSeq
  Googology.Trans.PoR.InaccPsi.R2 Googology.Trans.PoR.InaccPsi.R2.Le Googology.Trans.PoR.InaccPsi.R2.Ts

/-- **Normal forms in base `Ω₂` with every level and every digit in `P`.** -/
inductive TzG (P : Ordinal.{0} → Prop) : Ordinal.{0} → Prop
  | zero : TzG P 0
  | cons {j d r : Ordinal.{0}} : P j → P d → 0 < d → d < Om (1 + 1) → r < leWe j → TzG P r →
      TzG P (leWe j * d + r)

/-- `w_j ≤ w_j·d + r < w_{j+1}` for `0 < d < Ω₂`, `r < w_j`. -/
theorem tz_term_bounds {j d r : Ordinal.{0}} (hd0 : 0 < d) (hd2 : d < Om (1 + 1)) (hr : r < leWe j) :
    leWe j ≤ leWe j * d + r ∧ leWe j * d + r < leWe (j + 1) := by
  refine ⟨(le_mul_left (leWe j) hd0).trans le_self_add, ?_⟩
  calc leWe j * d + r < leWe j * d + leWe j := (add_lt_add_iff_left _).2 hr
    _ = leWe j * (d + 1) := by rw [mul_add_one]
    _ ≤ leWe j * Om (1 + 1) := mul_le_mul_right (Order.add_one_le_of_lt hd2) _
    _ = leWe (j + 1) := (leWe_succ j).symm

/-- **The level of a top term is unique.** -/
theorem tz_lev_unique {j k x : Ordinal.{0}} (h1 : leWe j ≤ x) (h2 : x < leWe (j + 1)) (h3 : leWe k ≤ x)
    (h4 : x < leWe (k + 1)) : j = k := by
  rcases lt_trichotomy j k with h | h | h
  · exact absurd ((leWe_mono (Order.add_one_le_of_lt h)).trans h3) (not_le.2 h2)
  · exact h
  · exact absurd ((leWe_mono (Order.add_one_le_of_lt h)).trans h1) (not_le.2 h4)

theorem tz_div_eq {j d r : Ordinal.{0}} (hr : r < leWe j) : (leWe j * d + r) / leWe j = d := by
  rw [Ordinal.mul_add_div _ (tsU_ne j), Ordinal.div_eq_zero_of_lt hr, add_zero]

theorem tz_mod_eq {j d r : Ordinal.{0}} (hr : r < leWe j) : (leWe j * d + r) % leWe j = r := by
  rw [Ordinal.mul_add_mod_self, Ordinal.mod_eq_of_lt hr]

/-- Two top-term representations agree. -/
theorem tz_rep_unique {j d r k d' r' : Ordinal.{0}} (hd0 : 0 < d) (hd2 : d < Om (1 + 1)) (hr : r < leWe j)
    (hd0' : 0 < d') (hd2' : d' < Om (1 + 1)) (hr' : r' < leWe k) (h : leWe j * d + r = leWe k * d' + r') :
    j = k ∧ d = d' ∧ r = r' := by
  obtain ⟨a1, a2⟩ := tz_term_bounds hd0 hd2 hr
  obtain ⟨b1, b2⟩ := tz_term_bounds hd0' hd2' hr'
  rw [h] at a1 a2
  have hjk : j = k := tz_lev_unique a1 a2 b1 b2
  subst hjk
  refine ⟨rfl, ?_, ?_⟩
  · have := tz_div_eq (d := d) hr; rw [h, tz_div_eq hr'] at this; exact this.symm
  · have := tz_mod_eq (d := d) hr; rw [h, tz_mod_eq hr'] at this; exact this.symm

variable {P : Ordinal.{0} → Prop}

/-- **Inversion.** -/
theorem tzG_inv {j d r : Ordinal.{0}} (hd0 : 0 < d) (hd2 : d < Om (1 + 1)) (hr : r < leWe j)
    (h : TzG P (leWe j * d + r)) : P j ∧ P d ∧ TzG P r := by
  generalize hx : leWe j * d + r = x at h
  cases h with
  | zero =>
    exact absurd hx (ne_of_gt ((leWe_pos j).trans_le (tz_term_bounds hd0 hd2 hr).1))
  | cons hj' hd' hd0' hd2' hr' hR' =>
    obtain ⟨e1, e2, e3⟩ := tz_rep_unique hd0 hd2 hr hd0' hd2' hr' hx
    subst e1; subst e2; subst e3
    exact ⟨hj', hd', hR'⟩

theorem TzG.mono {Q : Ordinal.{0} → Prop} (hPQ : ∀ z, P z → Q z) {x : Ordinal.{0}} (h : TzG P x) : TzG Q x := by
  induction h with
  | zero => exact TzG.zero
  | cons hj hd hd0 hd2 hr _ ih => exact TzG.cons (hPQ _ hj) (hPQ _ hd) hd0 hd2 hr ih

/-- A single digit at level `0`. -/
theorem tzG_small (h0 : P 0) {x : Ordinal.{0}} (hx : P x) (hx2 : x < Om (1 + 1)) : TzG P x := by
  rcases eq_or_ne x 0 with rfl | hx0
  · exact TzG.zero
  have := TzG.cons (P := P) (r := 0) h0 hx (pos_iff_ne_zero.2 hx0) hx2 (by rw [leWe_zero]; exact zero_lt_one)
    TzG.zero
  rwa [leWe_zero, one_mul, add_zero] at this

/-- `Ω₂ = w_1·1`. -/
theorem tzG_Om2 (h1 : P 1) : TzG P (Om (1 + 1)) := by
  have := TzG.cons (P := P) (j := 1) (d := 1) (r := 0) h1 h1 zero_lt_one (Gg.gg_one_lt_of_SC ts_SC_Om2)
    (leWe_pos 1) TzG.zero
  rwa [mul_one, add_zero, leWe_one] at this

/-- A single term `w_j·d`. -/
theorem tzG_term {j d : Ordinal.{0}} (hj : P j) (hd : P d) (hd0 : 0 < d) (hd2 : d < Om (1 + 1)) :
    TzG P (leWe j * d) := by
  have := TzG.cons (P := P) (r := 0) hj hd hd0 hd2 (leWe_pos j) TzG.zero
  rwa [add_zero] at this

/-- **`TzG P` is closed under `+`** when `P` is. -/
theorem tzG_add (hadd : ∀ a b, P a → P b → P (a + b)) :
    ∀ {x : Ordinal.{0}}, TzG P x → ∀ {y : Ordinal.{0}}, TzG P y → TzG P (x + y) := by
  intro x hx
  induction hx with
  | zero => intro y hy; rwa [zero_add]
  | @cons j d r hj hd hd0 hd2 hr hR ih =>
    intro y hy
    cases hy with
    | zero => rw [add_zero]; exact TzG.cons hj hd hd0 hd2 hr hR
    | @cons k d' r' hk hd' hd0' hd2' hr' hR' =>
      have hxj : leWe j * d + r < leWe (j + 1) := (tz_term_bounds hd0 hd2 hr).2
      rcases lt_trichotomy j k with hjk | rfl | hkj
      · -- the larger term absorbs `x`
        have hxk : leWe j * d + r < leWe k := hxj.trans_le (leWe_mono (Order.add_one_le_of_lt hjk))
        rw [← add_assoc, Rd.rdk_absorb (tsU_indec k) hxk (Order.one_le_iff_pos.2 hd0')]
        exact TzG.cons hk hd' hd0' hd2' hr' hR'
      · -- the same level: the digits add
        have e : leWe j * d + r + (leWe j * d' + r') = leWe j * (d + d') + r' := by
          rw [add_assoc, ← add_assoc r, Rd.rdk_absorb (tsU_indec j) hr (Order.one_le_iff_pos.2 hd0'), ← add_assoc,
            ← mul_add]
        rw [e]
        exact TzG.cons hj (hadd _ _ hd hd') (hd0.trans_le le_self_add) (ts_Om2_indec.add_lt hd2 hd2') hr' hR'
      · -- a smaller level: it goes into the rest
        have hyk : leWe k * d' + r' < leWe j :=
          (tz_term_bounds hd0' hd2' hr').2.trans_le (leWe_mono (Order.add_one_le_of_lt hkj))
        rw [add_assoc]
        exact TzG.cons hj hd hd0 hd2 ((tsU_indec j).add_lt hr hyk) (ih (TzG.cons hk hd' hd0' hd2' hr' hR'))

/-- **The last term**: `TzG P (B + w_λ·D)` with `w_{λ+1} ∣ B`, `0 < D < Ω₂` gives `P λ`, `P D` and `TzG P B`. -/
theorem tzG_snoc_inv {l D : Ordinal.{0}} (hD0 : 0 < D) (hD2 : D < Om (1 + 1)) :
    ∀ {x : Ordinal.{0}}, TzG P x → ∀ B, leWe (l + 1) ∣ B → x = B + leWe l * D → P l ∧ P D ∧ TzG P B := by
  have hlD : leWe l * D < leWe (l + 1) := by
    have := (tz_term_bounds (r := 0) hD0 hD2 (leWe_pos l)).2; rwa [add_zero] at this
  intro x hx
  induction hx with
  | zero =>
    intro B _ h
    exact absurd h.symm (ne_of_gt ((mul_pos (leWe_pos l) hD0).trans_le le_add_self))
  | @cons j d r hj hd hd0 hd2 hr hR ih =>
    intro B hB h
    rcases eq_or_ne B 0 with rfl | hB0
    · rw [zero_add] at h
      have h' : leWe j * d + r = leWe l * D + 0 := by rw [add_zero]; exact h
      obtain ⟨e1, e2, e3⟩ := tz_rep_unique hd0 hd2 hr hD0 hD2 (leWe_pos l) h'
      subst e1; subst e2; subst e3
      exact ⟨hj, hd, TzG.zero⟩
    · obtain ⟨m, hm⟩ := hB
      have hm0 : m ≠ 0 := by rintro rfl; rw [mul_zero] at hm; exact hB0 hm
      have hBge : leWe (l + 1) ≤ B := by rw [hm]; exact le_mul_left _ (pos_iff_ne_zero.2 hm0)
      have hxj := tz_term_bounds hd0 hd2 hr
      have hlj : l + 1 ≤ j := by
        by_contra hc
        push Not at hc
        have : leWe (j + 1) ≤ leWe (l + 1) := leWe_mono (Order.add_one_le_of_lt hc)
        exact absurd ((hxj.2.trans_le this).trans_le (hBge.trans (le_self_add.trans_eq h.symm)))
          (lt_irrefl _)
      have hlDj : leWe l * D < leWe j := hlD.trans_le (leWe_mono hlj)
      set u := leWe j with hu
      have hBdec : u * (B / u) + B % u = B := Ordinal.div_add_mod B u
      have hBr : B % u < u := Ordinal.mod_lt B (tsU_ne j)
      have hsum : B % u + leWe l * D < u := (tsU_indec j).add_lt hBr hlDj
      have hx2 : u * (B / u) + (B % u + leWe l * D) = u * d + r := by
        rw [← add_assoc, hBdec, h]
      have hd' : B / u = d := by
        have := tz_div_eq (j := j) (d := B / u) hsum
        rw [hx2, tz_div_eq hr] at this; exact this.symm
      have hr' : B % u + leWe l * D = r := by
        have := tz_mod_eq (j := j) (d := B / u) hsum
        rw [hx2, tz_mod_eq hr] at this; exact this.symm
      have hdvd : leWe (l + 1) ∣ B % u := by
        have h1 : leWe (l + 1) ∣ u * (B / u) := (leWe_dvd hlj).mul_right _
        have h2 : leWe (l + 1) ∣ u * (B / u) + B % u := by rw [hBdec]; exact ⟨m, hm⟩
        exact (Ordinal.dvd_add_iff h1).1 h2
      obtain ⟨h1, h2, h3⟩ := ih (B % u) hdvd hr'.symm
      refine ⟨h1, h2, ?_⟩
      rw [← hBdec, hd']
      exact TzG.cons hj hd hd0 hd2 hBr h3

/-- `ω^b` below `W` from the components of `b`. -/
theorem tzG_opow (h0 : P 0) (hop : ∀ a, P a → P (ω ^ a)) {b : Ordinal.{0}} (hb : TzG P b)
    (hW : ω ^ b < leWe (Om (1 + 1))) : TzG P (ω ^ b) := by
  have h2 := ts_Om2_ne
  have hbq : b < Om (1 + 1) * Om (1 + 1) := by
    unfold leWe at hW; exact (opow_lt_opow_iff_right one_lt_omega0).1 hW
  set j := b / Om (1 + 1) with hj
  set d := b % Om (1 + 1) with hd
  have hjl : j < Om (1 + 1) := (Ordinal.lt_mul_iff_div_lt h2).1 hbq
  have hdl : d < Om (1 + 1) := Ordinal.mod_lt b h2
  have hbe : Om (1 + 1) * j + d = b := Ordinal.div_add_mod b _
  have hwe : ω ^ b = leWe j * ω ^ d := by unfold leWe; rw [← hbe, opow_add]
  have hdP : P d := by
    rcases eq_or_ne j 0 with hj0 | hj0
    · have hbd : b = d := by rw [← hbe, hj0, mul_zero, zero_add]
      rcases eq_or_ne d 0 with hd0 | hd0
      · rw [hd0]; exact h0
      have := (tzG_inv (j := 0) (d := d) (r := 0) (pos_iff_ne_zero.2 hd0) hdl (by rw [leWe_zero]; exact zero_lt_one)
        (by rw [leWe_zero, one_mul, add_zero, ← hbd]; exact hb)).2.1
      exact this
    · rcases eq_or_ne d 0 with hd0 | hd0
      · rw [hd0]; exact h0
      have hb' : TzG P (leWe 1 * j + d) := by rw [leWe_one, hbe]; exact hb
      have hd1 : d < leWe 1 := by rw [leWe_one]; exact hdl
      have hR := (tzG_inv (pos_iff_ne_zero.2 hj0) hjl hd1 hb').2.2
      exact (tzG_inv (j := 0) (d := d) (r := 0) (pos_iff_ne_zero.2 hd0) hdl
        (by rw [leWe_zero]; exact zero_lt_one) (by rw [leWe_zero, one_mul, add_zero]; exact hR)).2.1
  have hjP : P j := by
    rcases eq_or_ne j 0 with hj0 | hj0
    · rw [hj0]; exact h0
    · have hb' : TzG P (leWe 1 * j + d) := by rw [leWe_one, hbe]; exact hb
      have hd1 : d < leWe 1 := by rw [leWe_one]; exact hdl
      exact (tzG_inv (pos_iff_ne_zero.2 hj0) hjl hd1 hb').2.1
  have hod : ω ^ d < Om (1 + 1) := by
    rw [← ts_Om2_opow]; exact (opow_lt_opow_iff_right one_lt_omega0).2 hdl
  rw [hwe]
  exact tzG_term hjP (hop d hdP) (opow_pos _ omega0_pos) hod

/-- **`TzG P` is closed under `φ` below `W`** when `P` contains `0`, `1` and is closed under `φ`. -/
theorem tzG_phi (h0 : P 0) (h1 : P 1) (hphi : ∀ a b, P a → P b → P (veblen a b)) {a b : Ordinal.{0}}
    (ha : TzG P a) (hb : TzG P b) (hW : veblen a b < leWe (Om (1 + 1))) : TzG P (veblen a b) := by
  have hsmallP : ∀ {z : Ordinal.{0}}, TzG P z → z < Om (1 + 1) → P z := by
    intro z hz hz2
    rcases eq_or_ne z 0 with rfl | hz0
    · exact h0
    exact (tzG_inv (j := 0) (d := z) (r := 0) (pos_iff_ne_zero.2 hz0) hz2 (by rw [leWe_zero]; exact zero_lt_one)
      (by rw [leWe_zero, one_mul, add_zero]; exact hz)).2.1
  rcases eq_or_ne a 0 with rfl | ha0
  · rw [veblen_zero_apply] at hW ⊢
    exact tzG_opow h0 (fun z hz => by have := hphi 0 z h0 hz; rwa [veblen_zero_apply] at this) hb hW
  · have hε : ω ^ veblen a b = veblen a b := Tp.tpVeblen_fix (pos_iff_ne_zero.2 ha0)
    rcases lt_trichotomy (veblen a b) (Om (1 + 1)) with hlt | heq | hgt
    · have ha2 : a < Om (1 + 1) := (left_le_veblen a b).trans_lt hlt
      have hb2 : b < Om (1 + 1) := (right_le_veblen a b).trans_lt hlt
      exact tzG_small h0 (hphi a b (hsmallP ha ha2) (hsmallP hb hb2)) hlt
    · rw [heq]; exact tzG_Om2 h1
    · exact absurd hW (not_lt.2 (ts_eps_ge_W hε hgt))

end Googology.Trans.PoR.InaccPsi.R2.Tz
