/-! ### Nearby ordinals

`pairDisagreements xs` counts the pairs whose labels and matrices are in different
order (a collision counts, since the labels differ); `crossDisagreements xs ys`
the same between two lists. -/

/-- Pairs within `xs` whose order differs. -/
def pairDisagreements (xs : Array (Od × List (List Nat))) : Nat := orderDisagreements xs

/-- Pairs across `xs` and `ys` whose order differs. -/
def crossDisagreements (xs ys : Array (Od × List (List Nat))) : Nat := Id.run do
  let mut bad := 0
  for a in xs do
    for b in ys do
      if cmpOrd a.1 b.1 != cmpMat a.2 b.2 then bad := bad + 1
  return bad

/-- Pairs within `xs` with one matrix. -/
def collisions (xs : Array (Od × List (List Nat))) : Nat := Id.run do
  let mut k := 0
  for i in [0:xs.size] do
    for j in [i+1:xs.size] do
      if xs[i]!.2 == xs[j]!.2 then k := k + 1
  return k

/-- Labels with their matrices by `f`. -/
def withM (f : String → List (List Nat)) (ls : List String) : Array (Od × List (List Nat)) :=
  (ls.map fun s => ((parse s).getD [], f s)).toArray

