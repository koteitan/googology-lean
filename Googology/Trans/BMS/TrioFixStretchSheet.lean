abbrev s2k : List (List Nat) := storey2.dropLast ++ [[9,2,0]]

-- Below the stretch nothing changes.
#guard sOf "(W_w*W)" = mBeta ∧ sOf "(W_w*W)" = allOf "(W_w*W)"
#guard sOf "(W_w*W+W_2)" = w2 ∧ sOf "(W_w*W+W_2)" = allOf "(W_w*W+W_2)"
#guard sOf "(W_w*W+W*w)" = sheet3480 ∧ sOf "(W_w*W+W*w)" = allOf "(W_w*W+W*w)"

-- The lifted copy is `blift` from the storey root `(1,1,0)` (column 11 of `w2`).
#guard toRows (blift (MS ((parse "(W_w*W+W_2)").getD [])) 11) = s2k
#guard toRows (bliftUpS (MS ((parse "(W_w*W+W_2)").getD [])) 11) = storey2

-- The three rows of the sheet (`stretch3`).  The sheet's matrices of rows 3481 and 3482
-- are `w2` with the leaf `(8,3,0)`, then `(2,2,1)` / `(7,4,1)`: not standard.
#guard sOf "(W_w*W+W_3)" = c2
#guard sOf "(W_w*W+W_w)" = lM
#guard sOf "(W_w*W2)" = w2 ++ [[7,4,1],[8,1,0]]
#guard sOf "(W_w*W+W_w)" ≠ w2.dropLast ++ [[8,3,0],[2,2,1]]
#guard sOf "(W_w*W2)" ≠ w2.dropLast ++ [[8,3,0],[7,4,1]]
#guard allOf "(W_w*W+W_w)" = w2.dropLast ++ [[8,3,0],[5,3,1]]
#guard allOf "(W_w*W2)" = w2.dropLast ++ [[8,3,0],[7,4,1],[8,1,0]]

-- The other readings of TRIO-ROW-3480.md.
#guard sOf "(W_w*W+W_w*w)" = w2 ++ [[7,4,1]]
#guard sOf "(W_w*W+W_w+1)" = w2 ++ [[7,4,0],[8,5,0]]
#guard sOf "(W_w*W+W_2+1)" = w2 ++ s2k ++ [[8,5,0],[9,6,0]]
#guard sOf "(W_w*W+W_2*w)" = w2 ++ s2k ++ [[8,5,1]]
#guard sOf "(W_w*W+W_2*W)" = w2 ++ s2k ++ [[8,5,1],[9,1,0]]
#guard sOf "(W_w*W+W_2^2)" = w2 ++ s2k ++ [[8,5,1],[9,2,0]]
#guard sOf "(W_w*W+W_4)" = expandRL 3 2 lM
-- The rules' readings they replace: `w2 ++ (7,4,1)` was `β+Ω_2·ω`, and `β+Ω_2+1` was
-- `w2 ++ (7,4,0)(8,5,0)`, now the matrix of `β+Ω_ω+1`.
#guard ruleOf "(W_w*W+W_2*w)" = w2 ++ [[7,4,1]]
#guard allOf "(W_w*W+W_2+1)" = w2 ++ [[7,4,0],[8,5,0]]

-- Fix D is still used outside the storey: row 3492 (Part 2) and row 3493.
#guard sOf "(W_w*W_2*w)" = allOf "(W_w*W_2*w)" ∧ sOf "(W_w*W_3)" = allOf "(W_w*W_3)"

/-! ### BMS expansion (`expandRL 3 n`, yaBMS `[n]`) -/

#guard expandRL 3 0 lM = sOf "(W_w*W+W_2)"
#guard expandRL 3 1 lM = sOf "(W_w*W+W_3)"
#guard expandRL 3 2 lM = sOf "(W_w*W+W_4)"
#guard expandRL 3 1 (sOf "(W_w*W*w)") = sOf "(W_w*W*2)"
#guard expandRL 3 2 (sOf "(W_w*W*w)") = sOf "(W_w*W*3)"
#guard expandRL 3 1 (sOf "(W_w*W+W*w)") = sOf "(W_w*W+W*2)"
#guard expandRL 3 1 (sOf "(W_w*W+W_2+w)") = sOf "(W_w*W+W_2+1)"
#guard expandRL 3 1 (sOf "(W_w*W+W_2*w)") = sOf "(W_w*W+W_2*2)"
#guard expandRL 3 2 (sOf "(W_w*W+W_2*w)") = sOf "(W_w*W+W_2*3)"
#guard expandRL 3 1 (sOf "(W_w*W+W_2^w)") = sOf "(W_w*W+W_2^2)"
#guard expandRL 3 2 (sOf "(W_w*W+W_2^w)") = sOf "(W_w*W+W_2^3)"
#guard expandRL 3 1 (sOf "(W_w*W+W_3*w)") = sOf "(W_w*W+W_3*2)"
#guard expandRL 3 1 (sOf "(W_w*W+W_w*2)") = sOf "(W_w*W+W_w+W_3)"
#guard expandRL 3 1 (sOf "(W_w*W+W_w*w)") = sOf "(W_w*W+W_w+W_2)"
-- Before Fix S, `(β·ω)[1] = b1` was not the matrix of `β·2`.
#guard expandRL 3 1 (allOf "(W_w*W*w)") ≠ allOf "(W_w*W*2)"

/-! ### 69 labels from `β` to `β·ω`

All 69 matrices are standard (yaBMS `bms -s`, outside Lean); with `TrioRulesAll`, 54 of
them are not.  One collision is expected: `Ω_2·Ω_2 = Ω_2^2` is one ordinal. -/

def stretchTails : List String := ["", "+1", "+2", "+w", "+w^2", "+W", "+W+1", "+W+2", "+W+w", "+W*2", "+W*3", "+W*w", "+W^2", "+W_2", "+W_2+1", "+W_2+2", "+W_2+3", "+W_2+w", "+W_2+W", "+W_2+W*2", "+W_2+W*w", "+W_2+W_2", "+W_2*2+1", "+W_2*3", "+W_2*4", "+W_2*w", "+W_2*w+1", "+W_2*w2", "+W_2*W", "+W_2*W+W_2", "+W_2*W2", "+W_2*W_2", "+W_2^2", "+W_2^2+1", "+W_2^2*2", "+W_2^2*w", "+W_2^3", "+W_2^w", "+W_2^W", "+W_2^W_2", "+W_3", "+W_3+1", "+W_3+W_2", "+W_3*2", "+W_3*w", "+W_3*W_2", "+W_3^2", "+W_4", "+W_4+1", "+W_5", "+W_w", "+W_w+1", "+W_w+2", "+W_w+W", "+W_w+W_2", "+W_w+W_3", "+W_w*2", "+W_w*3", "+W_w*w", "+W_w*w+1", "+W_w*w+W_2", "*2", "*2+1", "*2+W_2", "*2+W_3", "*2+W_w", "*3", "*4", "*w"]
/-- The family: `β` followed by each tail. -/
def stretchFam : List String := stretchTails.map fun t => "(W_w*W" ++ t ++ ")"

/-- The 784 chosen labels of Part 3 and row 3480. -/
def chosen785 : List String := chosen ++ [printed3552, "(W_w*W+W_3)"]

/-- `chosen785` with the matrices of Fix S. -/
def chosenDataS785 : Array (Od × List (List Nat)) := withM sOf chosen785

#guard stretchFam.length = 69 ∧ stretchFam.all fun s => (parse s).isSome
#guard (stretchFam.filter fun s => sOf s != allOf s).length = 59
#guard pairDisagreements (withM sOf stretchFam) = 0 ∧ collisions (withM sOf stretchFam) = 1
#guard pairDisagreements (withM allOf stretchFam) = 307 ∧ collisions (withM allOf stretchFam) = 4
#guard cmpOrd ((parse "(W_w*W+W_2*W_2)").getD []) ((parse "(W_w*W+W_2^2)").getD []) == .eq

-- The order check with row 3480: 785 matrices, 307,720 pairs.
#guard chosenDataS785.size = 785
#guard orderDisagreements chosenDataS785 = 0
#guard crossDisagreements (withM sOf stretchFam) chosenDataS785 = 0

/-! ### 525 labels on 21 bases

Each base followed by 25 tails.  Fix S changes 98 labels, all on the bases `β`,
`β·2`, `Ω_ω·Ω^2`, `Ω_ω^2·Ω` and `Ω_{ω^2}·Ω`: a countable regime (`ω` or `ω^2`) and a
storey laid after a leaf naming `Ω`.  Order disagreements: 654 → 537; on no base do they grow, and
on the `β` bases they go to 0.  The remaining 537 are on bases Fix S does not touch
(`Ω_ω+…`, `Ω_ω·ω`, `Ω_ω·Ω_2`, `Ω_{ω+1}…`, `Ω_{ω·2}·Ω`, `Ω_Ω…`).  Standardness (yaBMS):
of the 98 changed matrices, 78 are standard (72 of them were not); the 20 others,
19 on the base `Ω_ω·Ω^2` and `Ω_{ω^2}·Ω+Ω_ω·2`, were not standard before either. -/

def wideBases : List String := ["W","W*2","W^2","W_2","W_2*W","W_3*W","W_w","W_w*2","W_w*w","W_w*W","W_w*W^2","W_w*W*2","W_w*W_2","W_w^2","W_w^2*W","W_(w+1)","W_(w+1)*W","W_(w2)*W","W_(w^2)*W","W_W","W_W*W"]
def wideTails : List String := ["+1", "+w", "+W", "+W+1", "+W*2", "+W*w", "+W_2", "+W_2+1", "+W_2+W", "+W_2*2", "+W_2*w", "+W_2*W", "+W_2^2", "+W_2^w", "+W_3", "+W_3+1", "+W_4", "+W_w", "+W_w+1", "+W_w*2", "+W_w*w", "*2", "*2+1", "*3", "*w"]
/-- The 525 labels. -/
def wideCorpus : List String :=
  (wideBases.flatMap fun b => wideTails.map fun t => "(" ++ b ++ t ++ ")").filter fun s =>
    (parse s).isSome

#guard wideCorpus.length = 525
#guard (wideCorpus.filter fun s => sOf s != allOf s).length = 98
#guard pairDisagreements (withM sOf wideCorpus) = 537
#guard pairDisagreements (withM allOf wideCorpus) = 654
#guard crossDisagreements (withM sOf wideCorpus) chosenDataS785 = 170
#guard crossDisagreements (withM allOf wideCorpus) chosenDataAll3 = 170
#guard wideBases.all fun b =>
  let l := wideCorpus.filter fun (s : String) =>
    s.startsWith ("(" ++ b ++ "+") || s.startsWith ("(" ++ b ++ "*")
  decide (pairDisagreements (withM sOf l) ≤ pairDisagreements (withM allOf l))

end Googology.Trans.BMS.TrioFixStretch
