/-! ## Part 5: against rules 1–10 and the single-fix versions

`interactionsS ls` lists the labels of `ls` where the patched matrix is not the one
expected with no interaction: `TrioRulesNonLast`'s when Fix E changes nothing
(`TrioRules3` = `TrioRules2`), `TrioRules3`'s when Fix N changes nothing, and any
label that both fixes change. -/

/-- `interactions` of `TrioRulesAllSheet.lean`, for the patched rules. -/
def interactionsS (ls : List String) : List String :=
  ls.filter fun s =>
    let a := sOf s
    let o := ruleOf2 s
    let e := ruleOf3 s
    let n := nOf s
    (e == o && a != n) || (n == o && a != e) || (e != o && n != o)

-- Fix S is the only new difference: the three labels of `stretch3`.
#guard interactionsS sheetLabels = stretch3
#guard sheetLabels.all fun s => stretch3.contains s || sOf s == allOf s
#guard interactionsS familyW = []
#guard interactionsS family1 = []
#guard interactionsS probes = []

-- Against rules 1–10: 27 labels differ (22 `S` rows, row 4533, printed row 3552, and
-- `stretch3`); `TrioRules2` differs on 23 of them.
