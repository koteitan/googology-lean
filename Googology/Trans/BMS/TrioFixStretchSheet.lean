/-! ## Part 7: one step against rules 1–10

With the same `Mf` (the merged builder one step of fuel down), compare the merged
step `MstepS` with `Mstep` of `TrioRules.lean` on every label used above (1,225
labels with repeats), by branch.  On countable `α` they agree everywhere (none of
Fixes B–D, N needs a regime; Fix A reaches a countable `α` only through `Mf`).  On
`ψ_{Ω_u}(X)` they differ exactly when `fixAFires` or `fixEFires` holds, and on
`Ω_v` exactly when `fixAFires` holds (one direction is the theorems
`MstepAll_eq_Mstep_psi`, `MstepAll_eq_Mstep_omega`).  On sums (`placeUnits`)
they differ on 260 of 870 (257 with `MstepAll`; the three more are `stretch3`). -/

/-- The patched builder one step of fuel down. -/
def MfPrevS : Od → Cols := MfuelS (fuel - 1)

/-- The patched step and rules 1–10's step differ on the label, with the same `Mf`. -/
def stepDiffersS (s : String) : Bool :=
  let a := (parse s).getD []
  MstepS MfPrevS a != Mstep MfPrevS a

/-- `MS` is one patched step on `MfPrevS`. -/
theorem MS_eq_step : MS = MstepS MfPrevS := rfl

#guard (["countable", "psi", "omega", "sum"].map fun k =>
    let ls := corpus.filter fun s => branch ((parse s).getD []) == k
    (k, ls.length, (ls.filter stepDiffersS).length)) =
  [("countable", 171, 0), ("psi", 32, 6), ("omega", 152, 7), ("sum", 870, 260)]
#guard (corpus.filter fun s => branch ((parse s).getD []) == "psi").all fun s =>
  match isPsiLevel ((parse s).getD []) with
  | some uX => stepDiffersS s == (fixAFires MfPrevS uX.1 || fixEFires MfPrevS uX.1 uX.2)
  | none => false
#guard (corpus.filter fun s => branch ((parse s).getD []) == "omega").all fun s =>
  match lvlO ((parse s).getD []) with
  | some v => stepDiffersS s == fixAFires MfPrevS v
  | none => false

-- Against `MstepAll` with the same `Mf`: the steps differ on exactly the labels of `stretch3`.
#guard corpus.filter (fun s => let a := (parse s).getD []; MstepS MfPrevS a != MstepAll MfPrevS a) = stretch3

