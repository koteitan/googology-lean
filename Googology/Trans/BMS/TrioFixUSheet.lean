/-! ## Part 7: one step against rules 1–10

With the same `Mf` (the Fix U builder one step of fuel down), compare the Fix U
step `MstepU` with `Mstep` of `TrioRules.lean` on every label used above (1,225
labels with repeats), by branch.  The counts are those of `TrioRulesAllSheet.lean`.
On `ψ_{Ω_u}(X)` they differ exactly when `fixAFires`, `fixEFires` or `fixUFires`
holds (`fixUFires` holds on none of these labels), and on `Ω_v` exactly when
`fixAFires` holds. -/


/-- The Fix U builder one step of fuel down. -/
def MfPrevU : Od → Cols := MfuelU (fuel - 1)


/-- The Fix U step and rules 1–10's step differ on the label, with the same `Mf`. -/
def stepDiffersU (s : String) : Bool :=
  let a := (parse s).getD []
  MstepU MfPrevU a != Mstep MfPrevU a

/-- `MU` is one Fix U step on `MfPrevU`. -/
theorem MU_eq_stepPrev : MU = MstepU MfPrevU := rfl

#guard (["countable", "psi", "omega", "sum"].map fun k =>
    let ls := corpus.filter fun s => branch ((parse s).getD []) == k
    (k, ls.length, (ls.filter stepDiffersU).length)) =
  [("countable", 171, 0), ("psi", 32, 6), ("omega", 152, 7), ("sum", 870, 257)]
#guard (corpus.filter fun s => branch ((parse s).getD []) == "psi").all fun s =>
  match isPsiLevel ((parse s).getD []) with
  | some uX => stepDiffersU s == (fixAFires MfPrevU uX.1 || fixEFires MfPrevU uX.1 uX.2 ||
    fixUFires MfPrevU uX.1 uX.2)
  | none => false
#guard (corpus.filter fun s => branch ((parse s).getD []) == "omega").all fun s =>
  match lvlO ((parse s).getD []) with
  | some v => stepDiffersU s == fixAFires MfPrevU v
  | none => false

