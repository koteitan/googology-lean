/-- The labels sorted by the order of the labels (`cmpOrd`) have their matrices in the
same order: each neighbouring pair compares the same way.  (With `cmpOrd` a total
order and `cmpMat` the lexicographic order this is the pairwise order check, in
`n log n` comparisons.) -/
def sortedAgree (xs : List (Od × List (List Nat))) : Bool :=
  let s := xs.mergeSort fun a b => cmpOrd a.1 b.1 != .gt
  (s.zip s.tail).all fun p => cmpOrd p.1.1 p.2.1 == cmpMat p.1.2 p.2.2

/-- The probes in the domain, with Fix U's matrices. -/
def domainDataU : Array (Od × List (List Nat)) := withM uOf domainProbes

-- Order: none of the 157,641 pairs of the 562 labels disagrees.
#guard domainDataU.size = 562
#guard pairDisagreements domainDataU = 0
-- With the 784 chosen labels (the 783 rows and the printed label of row 3552).
#guard sortedAgree ((withM uOf (domainProbes ++ chosen ++ [printed3552])).toList)
-- Without Fix U the sorted check fails, and 403 of the 562 matrices change.
#guard !sortedAgree ((withM TrioRulesAll.allOf (domainProbes ++ chosen ++ [printed3552])).toList)
#guard (domainProbes.filter fun s => uOf s != TrioRulesAll.allOf s).length = 403

