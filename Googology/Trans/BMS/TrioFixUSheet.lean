  uOf "psi_W_(W+2)(W_W_(W+1))" ++ [[11,4,1],[12,4,1],[13,1,0],[11,4,1],[12,4,1],[13,1,0]]
-- The table at `L = 2` (`u = Ω_2+1`): `P = ψ_{Ω_u}(Ω_{Ω_3})`, the mark `(3,3,1)`.
#guard uOf "psi_W_(W_2+1)(W_W_w)" = uOf "psi_W_(W_2+1)(W_W_3)" ++ [[3,3,1]]
#guard TrioRulesAll.allOf "psi_W_(W_2+1)(W_W_w)" =
  (uOf "psi_W_(W_2+1)(W_W_3)").take 27 ++ [[10,1,0],[8,4,1]]
#guard (List.range 3).all fun n =>
  expandRL 3 n (uOf "psi_W_(W_2+1)(W_W_w)") = uOf ("psi_W_(W_2+1)(W_W_" ++ toString (n + 3) ++ ")")
#guard (List.range 3).all fun n =>
  expandRL 3 n (uOf "psi_W_(W_3+1)(W_W_w)") = uOf ("psi_W_(W_3+1)(W_W_" ++ toString (n + 4) ++ ")")
#guard uOf "psi_W_(W_2+1)(W_W_W)" = uOf "psi_W_(W_2+1)(W_W_3)" ++ [[3,3,1],[4,3,1],[5,1,0]]
-- The collapse row at `t = L+1 = 3`: `ψ_2(Ω_3)` hangs from the lowered leaf `(10,2,0)`.
#guard uOf "psi_W_(W_2+1)(W_psi_2(W_3))" =
  (uOf "psi_W_(W_2+1)(W_W_3)").take 27 ++ [[10,2,0],[11,3,0]]
-- A sum in `(Ω_3, Ω_4)`: `reroot (low M(Ω_4)) (low R_1) M(Ω_3+1)`.
#guard uOf "psi_W_(W_2+1)(W_(W_3+1))" =
  (expandRL 3 1 (uOf "psi_W_(W_2+1)(W_W_w)")).dropLast ++ [[11,3,0],[10,5,0],[11,6,0]]

/-- Does the BM4 expansion commute with the lift, `(P ++ lift(M(w)[4:]))[n] =
P ++ lift(M(w)[n][4:])`, for `n = 0, …, 3`? -/
def liftCommutes (u w : String) (L : Nat) (lift : Nat → Cols → Cols) : List Bool :=
  let P := toRows (PL MfPrevU L ((parse u).getD []))
  let m := MU ((parse w).getD [])
  (List.range 4).map fun n =>
    expandRL 3 n (uOf ("psi_W_" ++ u ++ "(W_" ++ w ++ ")")) ==
      P ++ toRows (lift L (ofRows (expandRL 3 n (toRows m))))

-- At `L = 2` exactly as at `L = 1` (where the level-`ω` rows are Fix E): the expansion
-- commutes except for `n ≥ 1` on `Ω_ω`, `Ω_ω·2`, `Ω_{ω²}`, whose bad root is in the
-- dropped head `B`.
#guard ["W_w", "(W_w+1)", "(W_w*2)", "W_(w+1)", "(W_(w+1)+1)", "W_(w2)", "W_(w^2)"].all fun w =>
  liftCommutes "(W_2+1)" w 2 liftLk == liftCommutes "(W+1)" w 1 liftLk
#guard ["(W_w+1)", "W_(w+1)", "(W_(w+1)+1)", "W_(w2)"].all fun w =>
  liftCommutes "(W_2+1)" w 2 liftLk == [true, true, true, true]
#guard ["W_(w^w)", "W_(w^w+1)", "W_psi(W)", "W_psi(W_w)"].all fun w =>
  liftCommutes "(W_2+1)" w 2 liftBk == [true, true, true, true] &&
    liftCommutes "(W+1)" w 1 liftBk == [true, true, true, true]

end Googology.Trans.BMS.TrioFixU
