open Googology.Trans.BMS (expandRL)

/-- `ordPair a b`: the order of the labels `a`, `b` as ordinals. -/
def ordPair (a b : String) : Ordering := cmpOrd ((parse a).getD []) ((parse b).getD [])

/-! ## The regressions of `TrioFixNonLastOther` that the narrowing removes

For each pair `(a, b)`: `TrioRulesAll` (`allOf`, before `TrioFixNonLastOther`) puts the
matrices in the order of the ordinals, `TrioFixNonLastOther` (`xOf`) does not, and this
patch (`x2Of`) does. -/

/-- The pairs of the review: Fix M (`Ω_2`, `Ω_3`, `Ω_4`, `Ω+1`, `Ω_{Ω+1}`), Fix G
(`Ω_{ω·2}`, `Ω_{ω+2}`, `Ω_{Ω_ω}`) and change 1 (`Ω_{ω^2}`). -/
def reviewPairs : List (String × String) := [
  ("W_W_2+W_w+W", "W_W_2+W+w"),
  ("W_W_3+W_w+W", "W_W_3+W+w"),
  ("W_W_4+W_w+W", "W_W_4+W+w"),
  ("W_(W+1)+W_w+W", "W_(W+1)+W+w"),
  ("W_W_(W+1)+W_w+W", "W_W_(W+1)+W+w"),
  ("W_W_(w2)+W_(w2)", "W_W_(w2)+W_W+W"),
  ("W_W_(w+2)+W_W+W", "W_W_(w+2)+W_(w+1)+w"),
  ("W_W_W_w+W_W+W", "W_W_W_w+W_w+1"),
  ("W_W_(w^2)+W_(w2)", "W_W_(w^2)+W_w+W")]

#guard reviewPairs.length = 9
#guard reviewPairs.all fun (a, b) =>
  let o := ordPair a b
  cmpMat (x2Of a) (x2Of b) == o && cmpMat (xOf a) (xOf b) != o && cmpMat (allOf a) (allOf b) == o

