/-! ## Against `TrioRulesAll` on the families of the review and nearby

`brokenFixed xs ys = (b, f)`: `b` pairs are in the order of the ordinals under `ys`
(`TrioRulesAll`) and not under `xs` (this patch), `f` the other way round.  Each guard is
`(disagreements, colliding pairs)` of this patch, the same of `TrioRulesAll`, and
`brokenFixed`. -/

/-- `(broken, fixed)` of `xs` against `ys` (same labels, same order). -/
def brokenFixed (xs ys : Array (Od × List (List Nat))) : Nat × Nat := Id.run do
  let mut b := 0
  let mut f := 0
  for i in [0:xs.size] do
    for j in [i+1:xs.size] do
      let o := cmpOrd xs[i]!.1 xs[j]!.1
      let okx := cmpMat xs[i]!.2 xs[j]!.2 == o
      let oky := cmpMat ys[i]!.2 ys[j]!.2 == o
      if oky && !okx then b := b + 1
      if okx && !oky then f := f + 1
  return (b, f)

/-- The five counts of a family: this patch, `TrioRulesAll`, `brokenFixed`. -/
def famCounts (ls : List String) : Nat × Nat × Nat × Nat × (Nat × Nat) :=
  let xs := withM x2Of ls
  let ys := withM allOf ls
  (pairDisagreements xs, collisions xs, pairDisagreements ys, collisions ys, brokenFixed xs ys)

