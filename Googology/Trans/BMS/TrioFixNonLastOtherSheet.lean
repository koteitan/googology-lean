/-! ## Part 7: one step against rules 1–10 and against the merged step

With the same `Mf` (the patched builder one step of fuel down), compare the patched
step `MstepX` with `Mstep` of `TrioRules.lean` and with `MstepAll` on every label of
`corpus` (`TrioRulesAllSheet.lean`), by branch.  On `ψ_{Ω_u}(X)` and `Ω_v` the patched
step is `MstepAll`'s (the theorems `MstepX_psi`, `MstepX_omega`), so the first two
checks of `TrioRulesAllSheet.lean` carry over. -/

/-- The patched builder one step of fuel down. -/
def MfPrevX : Od → Cols := MfuelX (fuel - 1)

/-- The patched step and rules 1–10's step differ on the label, with the same `Mf`. -/
def stepDiffersX (s : String) : Bool :=
  let a := (parse s).getD []
  MstepX MfPrevX a != Mstep MfPrevX a

/-- The patched step and the merged step differ on the label, with the same `Mf`. -/
def stepDiffersXAll (s : String) : Bool :=
  let a := (parse s).getD []
  MstepX MfPrevX a != MstepAll MfPrevX a

/-- `MX` is one patched step on `MfPrevX`. -/
theorem MX_eq_step : MX = MstepX MfPrevX := rfl

#guard ((["countable", "psi", "omega", "sum"].map fun k =>
    let ls := corpus.filter fun s => branch ((parse s).getD []) == k
    (k, ls.length, (ls.filter stepDiffersX).length, (ls.filter stepDiffersXAll).length))) = [("countable", 171, 0, 0), ("psi", 32, 6, 0), ("omega", 152, 7, 0), ("sum", 870, 259, 6)]
#guard (corpus.filter fun s => branch ((parse s).getD []) == "psi").all fun s =>
  match isPsiLevel ((parse s).getD []) with
  | some uX => stepDiffersX s == (fixAFires MfPrevX uX.1 || fixEFires MfPrevX uX.1 uX.2)
  | none => false
#guard (corpus.filter fun s => branch ((parse s).getD []) == "omega").all fun s =>
  match lvlO ((parse s).getD []) with
  | some v => stepDiffersX s == fixAFires MfPrevX v
  | none => false

